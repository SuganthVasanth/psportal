# Backend base URL (login API + Google OAuth redirect flow). Must match backend/.env GOOGLE_CALLBACK_URL host.
# Example if Google Console redirect is http://127.0.0.1:5000/auth/google/callback:
# VITE_API_BASE=http://127.0.0.1:5000
VITE_API_BASE=http://localhost:5000

# Backend OAuth: set GOOGLE_CLIENT_ID (and related secrets) in backend .env.

# Optional student "Assessment hub" (/assessments). Classic /book-slots + /course/:id unchanged.
VITE_USE_ASSESSMENT_HUB=true
