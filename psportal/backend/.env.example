PORT=5000

# Google OAuth (Passport) — must match “Authorized redirect URIs” in Google Cloud exactly (no trailing slash).
# Must match the host you use in frontend VITE_API_BASE (localhost vs 127.0.0.1 are different to Google).
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# If Google Console only has redirect http://127.0.0.1:5000/auth/google/callback, use:
# GOOGLE_CALLBACK_URL=http://127.0.0.1:5000/auth/google/callback
# and set frontend .env: VITE_API_BASE=http://127.0.0.1:5000
#
# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID (Web application):
#   Authorized JavaScript origins: http://localhost:5173
#   Authorized redirect URIs: exactly GOOGLE_CALLBACK_URL (recommended: add BOTH localhost and 127.0.0.1 if unsure)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=
